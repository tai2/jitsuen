{
  "name": "jitsuen",
  "version": "1.0.0",
  "description": "Claude Code-driven demo video pipeline (HyperFrames + VOICEVOX)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "hyperframes preview .",
    "studio": "hyperframes preview .",
    "engine": "scripts/voicevox-engine.sh start",
    "engine:stop": "scripts/voicevox-engine.sh stop",
    "voices": "node --experimental-strip-types scripts/list-voices.ts",
    "ingest": "node --experimental-strip-types scripts/ingest-assets.ts",
    "new": "node --experimental-strip-types scripts/new-video.ts",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "voice": "node --experimental-strip-types scripts/synthesize.ts",
    "check": "node --experimental-strip-types scripts/check-timing.ts",
    "render": "node --experimental-strip-types scripts/render.ts",
    "typecheck": "tsc",
    "lint": "hyperframes lint . && eslint src scripts && tsc",
    "browser": "hyperframes browser ensure",
    "audit": "hyperframes check .",
    "clean": "hyperframes clean"
  },
  "dependencies": {
    "@hyperframes/core": "0.8.174",
    "gsap": "3.14.2",
    "hyperframes": "0.8.174",
    "mediabunny": "1.61.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "zod": "4.5.4"
  }
}
