{
  "name": "demo-video-pipeline",
  "version": "1.0.0",
  "description": "Claude Code-driven demo video pipeline (Remotion + VOICEVOX)",
  "repository": {},
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "scripts": {
    "dev": "remotion studio",
    "studio": "remotion studio",
    "engine": "scripts/voicevox-engine.sh start",
    "engine:stop": "scripts/voicevox-engine.sh stop",
    "voices": "node --experimental-strip-types scripts/list-voices.ts",
    "ingest": "node --experimental-strip-types scripts/ingest-assets.ts",
    "reset:input": "node --experimental-strip-types scripts/reset-input.ts",
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "voice": "node --experimental-strip-types scripts/synthesize.ts",
    "check": "node --experimental-strip-types scripts/check-timing.ts",
    "render": "node --experimental-strip-types scripts/render.ts",
    "typecheck": "tsc",
    "lint": "eslint src scripts && tsc"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.536",
    "@remotion/captions": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "4.0.536",
    "@remotion/media": "4.0.536",
    "@remotion/renderer": "4.0.536",
    "@remotion/transitions": "4.0.536",
    "mediabunny": "1.61.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "zod": "4.5.4"
  }
}
