node_modules
dist
.DS_Store
.env

# Render output, all of it. The credits file is regenerated by every render, and the
# character actually used is already recorded in the tracked input/storyboard.json
# (voice.styleId), so nothing permanent is lost by ignoring it.
out/

# Synthesis cache and engine runtime state — regenerable, content-addressed.
.cache

# Generated narration WAVs. Large and fully regenerable from narration.json + the engine.
public/voiceover

# Mirror of input/assets/, rebuilt by `pnpm ingest` so staticFile() can reach the media.
public/assets

# Everything about the CURRENT video: the brief, the storyboard, the narration manifest,
# the theme tokens, the authored composition and the source media. It is project-specific
# and frequently confidential — a brief and a narration script are usually the client's,
# not the tool's — so none of it is tracked. `pnpm new` rebuilds it from templates/.
video/
