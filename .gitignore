node_modules
dist
.DS_Store
.env

# Render output, all of it. The credits file is regenerated by every render, and the
# character actually used is already recorded in the tracked input/storyboard.json
# (voice.styleId), so nothing permanent is lost by ignoring it.
out/

# Synthesis cache and engine runtime state — regenerable, content-addressed.
.cache

# HyperFrames working state: check/snapshot artifacts, render history, and the authoring
# proxy cache it transcodes browser-hostile codecs into. All regenerable.
.hyperframes/
.transcode-cache/

# The generated serving tree: media mirrored from video/assets/, narration WAVs from
# VOICEVOX, the bundled fonts and the vendored GSAP build. All of it is rebuilt by
# `pnpm ingest` and `pnpm voice`; none of it is a source of truth.
assets/

# The authored root composition. It holds this video's scene mounts and narration with
# their literal timings, so it is per-video content like everything under video/ — it just
# has to sit at the project root, because HyperFrames requires the entry to be index.html
# and a composition cannot reach above its project root.
/index.html

# Everything about the CURRENT video: the brief, the storyboard, the narration manifest,
# the theme tokens, the authored composition and the source media. It is project-specific
# and frequently confidential — a brief and a narration script are usually the client's,
# not the tool's — so none of it is tracked. `pnpm new` rebuilds it from templates/.
video/
